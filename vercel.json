{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/markdown.js": { "includeFiles": "content/blogs.js" },
    "api/post.js": {
      "includeFiles": "{post.html,content/*.js,scripts/render-blog.js}"
    }
  },
  "rewrites": [
    { "source": "/post/:slug", "destination": "/api/post?id=:slug" },
    { "source": "/markdown/:slug", "destination": "/api/markdown?id=:slug" }
  ],
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/post/:slug",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/:page(index|post|team).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
