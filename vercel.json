{
  "functions": {
    "api/markdown.js": { "includeFiles": "content/blogs.js" }
  },
  "rewrites": [
    { "source": "/post/:slug", "destination": "/post.html" },
    { "source": "/markdown/:slug", "destination": "/api/markdown?id=:slug" }
  ],
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/post/:slug",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/:page(index|post|team).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
